# Copia este archivo a .env y completa los valores de tu proveedor.
# Nunca guardes una API key real en Git ni la envíes desde el frontend.
LLM_PROVIDER=openai_compatible
LLM_API_KEY=tu-api-key-aqui
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

LLM_TIMEOUT_SECONDS=30
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.2

# Audio/transcripción: modelo independiente del modelo de chat/visión.
# Ejemplo para una cuenta OpenAI; en otros proveedores usa un modelo compatible.
MEDIA_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
MEDIA_MAX_AUDIO_MB=25

# Límites de video y procesamiento. Ajusta según recursos y política de costes.
MEDIA_MAX_VIDEO_MB=50
MEDIA_VIDEO_MAX_DURATION_SECONDS=120
MEDIA_VIDEO_MAX_FRAMES=8
MEDIA_VIDEO_FRAME_INTERVAL_SECONDS=5
MEDIA_PROCESSING_TIMEOUT_SECONDS=60

