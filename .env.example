# ============================================================
# FastAPI AI Integration Basic — Configuración de entorno
# ============================================================
# Copia este archivo a .env en la raíz del repositorio y completa
# los valores según tu proveedor. NO subas .env a Git (está en .gitignore).
# ============================================================

# --- Módulos activos (separados por comas) ---
# Ejemplos:
#   ENABLED_MODULES=products              # Solo CRUD demo
#   ENABLED_MODULES=llm                   # Solo generación de texto
#   ENABLED_MODULES=llm,media             # LLM + multimedia (requiere llm)
#   ENABLED_MODULES=llm,media,products    # Todos (por defecto)
ENABLED_MODULES=llm,media,products

# --- Proveedor LLM ---
# Actualmente solo "openai_compatible" está implementado.
# Para añadir otro proveedor, crea un adaptador en app/modules/llm/adapters/
# y regístralo en app/modules/llm/adapters/__init__.py (build_provider).
LLM_PROVIDER=openai_compatible

# --- Configuración del proveedor LLM ---
# Opción A: Proveedor local (Ollama, LM Studio, etc.) — sin coste, HTTP permitido en loopback
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=llama3.1:8b
# LLM_API_KEY=local              # Valor de relleno si tu Settings exige clave

# Opción B: Proveedor en la nube con API key — HTTPS obligatorio
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...             # Tu API key real (nunca la subas a Git)
# LLM_MODEL=gpt-4o-mini

# Parámetros de generación (opcionales, tienen valores por defecto)
LLM_TIMEOUT_SECONDS=30.0
LLM_MAX_TOKENS=512
LLM_TEMPERATURE=0.2

# --- Configuración multimedia (audio/video) ---
# Modelo de transcripción (Whisper u otro compatible con /audio/transcriptions)
# Independiente de LLM_MODEL — usa endpoint dedicado
# MEDIA_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Límites de carga (MB)
MEDIA_MAX_AUDIO_MB=25
MEDIA_MAX_VIDEO_MB=50

# Parámetros de procesamiento de video
MEDIA_VIDEO_MAX_DURATION_SECONDS=120
MEDIA_VIDEO_MAX_FRAMES=8
MEDIA_VIDEO_FRAME_INTERVAL_SECONDS=5
MEDIA_PROCESSING_TIMEOUT_SECONDS=60.0

# ============================================================
# Notas de seguridad
# ============================================================
# - La clave del proveedor LLM NO autentica a los consumidores de esta API.
#   La autenticación de clientes será un módulo separado (Fase 2).
# - Para hosts externos, LLM_BASE_URL DEBE usar HTTPS.
#   HTTP solo está permitido en loopback (localhost, 127.0.0.1, ::1).
# ============================================================