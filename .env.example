# --- Módulos activos (separados por comas) ---
ENABLED_MODULES=llm,media,products

# --- Proveedor LLM ---
LLM_PROVIDER=openai_compatible

# Opción A: local (sin coste). Ollama:
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=<modelo-descargado>
# LLM_API_KEY=local            # Valor de relleno si tu Settings exige clave

# Opción B: proveedor en la nube con API key (HTTPS obligatorio)
# LLM_BASE_URL=https://<host-del-proveedor>/v1
# LLM_API_KEY=<tu-clave>
# LLM_MODEL=<modelo>