# Copia este archivo a .env y completa los valores de tu proveedor.
# Nunca guardes una API key real en Git ni la envíes desde el frontend.
# Los valores que se muestran a continuación son solo ejemplos: reemplázalos
# por los de tu proveedor antes de ejecutar la aplicación.
LLM_PROVIDER=openai_compatible
LLM_API_KEY=tu-api-key-aqui
LLM_BASE_URL=https://tu-proveedor.example.com/v1
LLM_MODEL=tu-modelo-aqui
#LLM_TIMEOUT_SECONDS=30
#LLM_MAX_TOKENS=512
#LLM_TEMPERATURE=0.2
